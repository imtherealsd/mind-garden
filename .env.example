# ==============================================================================
# Mind Garden — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Razorpay Gateway (Indus Appstore / Web Checkout)
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Test Mode: rzp_test_... | Live Mode: rzp_live_...
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_here

# ------------------------------------------------------------------------------
# 2. Google AdMob (Android Rewarded Video Ads)
# Get your IDs from: https://admob.google.com/
# Default fallback: Google's official test ad unit ID
# ------------------------------------------------------------------------------
VITE_ADMOB_APP_ID=ca-app-pub-your_admob_app_id_here~1234567890
VITE_ADMOB_REWARDED_AD_ID=ca-app-pub-your_admob_app_id_here/1234567890

# ------------------------------------------------------------------------------
# 3. Firebase (Google Cloud Auth & Firestore Sync)
# Get your config from: https://console.firebase.google.com/ -> Project Settings
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
