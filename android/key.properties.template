# Dimension Bird - Android Release Signing Configuration Template
# Instructions:
# 1. Copy this file to 'android/key.properties'
# 2. Generate a release keystore using keytool or Android Studio.
#    Example command:
#    keytool -genkey -v -keystore release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias dimension-bird-alias
# 3. Put your release-key.jks inside 'android/app/' or specify the absolute path.
# 4. Fill in the credentials below. Do NOT commit 'key.properties' to git.

storeFile=release-key.jks
storePassword=your_store_password_here
keyAlias=dimension-bird-alias
keyPassword=your_key_password_here
